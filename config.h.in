#ifndef BITRL_CONFIG_H
#define BITRL_CONFIG_H

/*The robot, sensor and world definitions in the source tree bitrl was built from*/
#define BITRL_SOURCE_DATA_DIR "@BITRL_SOURCE_DATA_DIR@"

/*Where the robot, sensor and world definitions are installed*/
#define BITRL_INSTALL_DATA_DIR "@BITRL_INSTALL_DATA_DIR@"

/*DEBUG*/
#cmakedefine BITRL_DEBUG

/*Flag indicating that the library should log various messages*/
#cmakedefine BITRL_LOG

/*Use Chrono*/
#cmakedefine BITRL_CHRONO

/*Use Irrlicht for visualization*/
#cmakedefine BITRL_IRRLICHT

/*Use OpenCV*/
#cmakedefine BITRL_OPENCV

/*Use MQTT/Paho*/
#cmakedefine BITRL_MQTT

#endif

