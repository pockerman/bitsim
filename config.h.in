#ifndef BITSIM_CONFIG_H
#define BITSIM_CONFIG_H

/*The robot, sensor and world definitions in the source tree bitsim was built from*/
#define BITSIM_SOURCE_DATA_DIR "@BITSIM_SOURCE_DATA_DIR@"

/*Where the robot, sensor and world definitions are installed*/
#define BITSIM_INSTALL_DATA_DIR "@BITSIM_INSTALL_DATA_DIR@"

/*DEBUG*/
#cmakedefine BITSIM_DEBUG

/*Flag indicating that the library should log various messages*/
#cmakedefine BITSIM_LOG

/*Use Chrono*/
#cmakedefine BITSIM_CHRONO

/*Use Irrlicht for visualization*/
#cmakedefine BITSIM_IRRLICHT

/*Use OpenCV*/
#cmakedefine BITSIM_OPENCV

/*Use MQTT/Paho*/
#cmakedefine BITSIM_MQTT

#endif

