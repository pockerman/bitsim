# bitrl CMake package. Use it with
#
#     find_package(bitrl 2 REQUIRED)
#     target_link_libraries(my_target PRIVATE bitrl::bitrl)
#
# and -DCMAKE_PREFIX_PATH=<where bitrl is installed> if that is not a system
# prefix. bitrl_WITH_CHRONO, bitrl_WITH_IRRLICHT, bitrl_WITH_MQTT
# and bitrl_WITH_OPENCV say what bitrl was built with.

@PACKAGE_INIT@

set(bitrl_WITH_CHRONO @bitrl_WITH_CHRONO@)
set(bitrl_WITH_IRRLICHT @bitrl_WITH_IRRLICHT@)
set(bitrl_WITH_MQTT @bitrl_WITH_MQTT@)
set(bitrl_WITH_OPENCV @bitrl_WITH_OPENCV@)

set_and_check(bitrl_DATA_DIR "@PACKAGE_BITRL_DATA_INSTALL_DIR@")

include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(Boost 1.74.0)
find_dependency(Eigen3)
if(bitrl_WITH_OPENCV)
    find_dependency(OpenCV)
endif()
if(bitrl_WITH_MQTT)
    find_dependency(PahoMqttCpp)
endif()
if(bitrl_WITH_IRRLICHT)
    find_dependency(Chrono COMPONENTS Irrlicht)
elseif(bitrl_WITH_CHRONO)
    find_dependency(Chrono)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/bitrlTargets.cmake")
check_required_components(bitrl)
